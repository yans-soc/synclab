# PostgreSQL database
DATABASE_URL=postgresql://synclab:synclab@localhost:5432/synclab
POSTGRES_USER=synclab
POSTGRES_PASSWORD=synclab
POSTGRES_DB=synclab

# Backend API
PORT=12000
JWT_SECRET=replace-with-random-secret-min-32-chars
JWT_EXPIRES_IN=1d
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# Frontend (Vite)
VITE_API_URL=/api/v1
